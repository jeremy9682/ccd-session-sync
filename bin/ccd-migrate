#!/usr/bin/env bash
# ccd-migrate — git-versioned migration of Claude Desktop session registries between accounts.
#
# The Claude Desktop sidebar session list is stored per logged-in account under
#   ~/Library/Application Support/Claude/claude-code-sessions/<accountUUID>/<orgUUID>/local_*.json
# Switching accounts empties the visible list because the new account's dir starts empty.
# The conversation transcripts themselves live account-agnostically in ~/.claude/projects,
# so this only re-points the sidebar index — it never touches your actual conversations.
#
# Usage:
#   ccd-migrate                 # detect direction, merge other account's entries into current, commit
#   ccd-migrate --dry-run       # show what would be copied, change nothing
#   ccd-migrate status          # owner, per-account dirs, uncommitted drift, recent commits
#   ccd-migrate log [n]         # migration history (default 15)
#   ccd-migrate undo            # git-revert the last migrate commit (then restart the Claude app)
#   ccd-migrate snapshot        # commit current state without migrating
# Overrides (when >2 accounts, or to force direction):
#   CCD_FROM=<acct-uuid-prefix> CCD_TO=<acct-uuid-prefix> ccd-migrate
set -euo pipefail
# Tool-local Git policy: no global filters, attribute conversions or injected config.
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 GIT_ATTR_NOSYSTEM=1
unset GIT_CONFIG_PARAMETERS GIT_CONFIG_COUNT GIT_ATTR_SOURCE

GD="${CCD_GIT_DIR:-$HOME/.ccd-sessions-git}"
WT="${CCD_CLAUDE_DIR:-$HOME/Library/Application Support/Claude}"
SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
safety() { python3 -I "$SELF_DIR/ccd-safety.py" "$GD" "$WT" "$@"; }
g() { git -c core.hooksPath=/dev/null -c core.fsmonitor=false -c log.showSignature=false -c commit.gpgsign=false -c diff.external= -c core.attributesFile=/dev/null -c core.autocrlf=false --git-dir="$GD" --work-tree="$WT" "$@"; }
LOCK="$GD/ccd.lock.d"
JOURNAL="$GD/ccd-operation.json"
begin_operation() {
  # Exclusive creation; retained on any later failure or interruption.
  python3 -I - "$JOURNAL" "$cmd" <<'PY_JOURNAL'
import json, os, sys
with open(sys.argv[1], 'x') as f:
    json.dump({'command': sys.argv[2], 'pid': os.getppid(), 'recovery': 'manual inspection required'}, f)
    f.flush(); os.fsync(f.fileno())
fd = os.open(os.path.dirname(sys.argv[1]), os.O_RDONLY)
try: os.fsync(fd)
finally: os.close(fd)
PY_JOURNAL
}
finish_operation() { rm -- "$JOURNAL"; }

# Stage known index paths only; preserve unrelated files and staged ownership.
stage() { safety stage; }
check_staged() {
  local rc=0
  g diff --cached --quiet || rc=$?
  if [ "$rc" -gt 1 ]; then echo "ERROR: cannot inspect staged changes" >&2; exit "$rc"; fi
  return "$rc"
}


usage() {
  cat <<'EOF'
ccd-migrate — sync Claude Desktop session index between accounts.
  ccd-migrate [--dry-run]   merge the other account's entries into the current one
  ccd-migrate status        accounts, per-dir counts, git state
  ccd-migrate log [n]       migration history (default 15)
  ccd-migrate undo          revert the last migrate commit
  ccd-migrate snapshot      commit current state without migrating
Env: CCD_FROM=<uuid-prefix> CCD_TO=<uuid-prefix> to force direction (>2 accounts).
EOF
}

# parse the subcommand/flag BEFORE touching the filesystem, so --help/unknown never migrate
cmd="${1:-migrate}"
case "$cmd" in
  -h|--help)  usage; exit 0 ;;
  --dry-run)  cmd=migrate ;;                     # dry-run flag is re-read from "$@" below; keep it there
  -*)         echo "ccd-migrate: unknown option '$cmd' (try --help)" >&2; exit 2 ;;
  *)          if [ $# -gt 0 ]; then shift; fi ;;
esac

case "$cmd" in
  migrate) for arg in "$@"; do [ "$arg" = --dry-run ] || { echo "unknown argument: $arg" >&2; exit 2; }; done ;;
  undo|snapshot|status) [ "$#" = 0 ] || { echo "unexpected argument" >&2; exit 2; } ;;
  log) [ "$#" -le 1 ] && [[ "${1:-15}" =~ ^[0-9]+$ ]] || { echo "invalid log count" >&2; exit 2; } ;;
  *) echo "unknown command: $cmd" >&2; exit 2 ;;
esac
[ -d "$GD" ] || { echo "ERROR: git repo missing. Run install.sh first." >&2; exit 1; }
[ -d "$WT/claude-code-sessions" ] || { echo "ERROR: session root missing." >&2; exit 1; }
DRY=0
for arg in "$@"; do if [ "$arg" = --dry-run ]; then DRY=1; fi; done
case "$cmd" in
  migrate|undo|snapshot)
    safety guard
    if [ "$DRY" = 0 ]; then
    mkdir "$LOCK" 2>/dev/null || { echo "ERROR: another operation or stale lock; inspect $LOCK manually" >&2; exit 1; }
    trap 'rmdir "$LOCK" 2>/dev/null || true' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    safety guard
    fi
    ;;
esac

case "$cmd" in
  log)      g log --oneline --stat -"${1:-15}"; exit 0 ;;
  undo)
    # All candidate/history/conflict checks happen before staging drift.
    mig=$(safety undo)
    begin_operation
    stage
    check_staged || g commit -q -m "drift: app-side changes before undo"
    g -c revert.reference=false revert --no-edit "$mig"
    finish_operation
    echo "reverted: $(g log --pretty=%s -1 "$mig") — fully quit and relaunch the Claude app to load it."
    exit 0 ;;
  snapshot)
    begin_operation
    stage
    if check_staged; then echo "clean — nothing to snapshot"; else g commit -m "snapshot: manual"; fi
    finish_operation
    exit 0 ;;
  status)
    echo "owner: $(python3 -I -c 'import json,sys;print(json.load(open(sys.argv[1]+"/cowork-enabled-cli-ops.json"))["ownerAccountId"])' "$WT" 2>/dev/null || echo '(unknown)')"
    python3 -I - "$WT" <<'PY'
import glob, os, sys, time
from pathlib import Path
WT = sys.argv[1]
for org in sorted(str(p) for p in (Path(WT)/'claude-code-sessions').glob('*/*') if p.is_dir()):
    fs = list(Path(org).glob('local_*.json'))
    newest = max((os.path.getmtime(f) for f in fs), default=0)
    ts = time.strftime('%m-%d %H:%M', time.localtime(newest)) if newest else 'empty'
    print(f"  {len(fs):>3} entries | newest {ts} | {'/'.join(org.split('/')[-2:])}")
PY
    echo "uncommitted drift: $(g status --short | wc -l | tr -d ' ') files"; g log --oneline -3
    exit 0 ;;
  migrate) : ;;
  *) echo "unknown command: $cmd" >&2; exit 1 ;;
esac

DRY=0
for a in "$@"; do if [ "$a" = "--dry-run" ]; then DRY=1; fi; done

# Validate direction and the complete plan before the first write. The planning
# pass also catches missing owner metadata before drift can be staged.
safety plan
if [ "$DRY" = 0 ]; then
  begin_operation
  stage
  check_staged || g commit -q -m "drift: app-side changes before migrate"
fi

# 2) plan + copy (tombstone-aware, newer-wins); python prints SUMMARY line last
OUT=$(DRY=$DRY CCD_FROM="${CCD_FROM:-}" CCD_TO="${CCD_TO:-}" python3 -I - "$WT" <<'PY'
import glob, json, os, re, shutil, sys, time, tempfile
from pathlib import Path
WT = sys.argv[1]; DRY = os.environ.get('DRY') == '1'
CCS = os.path.join(WT, 'claude-code-sessions'); LAM = os.path.join(WT, 'local-agent-mode-sessions')
UUID = re.compile(r'^[0-9a-f]{8}-[0-9a-f-]+$')
try:
    owner = json.load(open(os.path.join(WT, 'cowork-enabled-cli-ops.json')))['ownerAccountId']
except Exception as e:
    sys.exit(f"ERROR: cannot read ownerAccountId from cowork-enabled-cli-ops.json ({e}). Is Claude Desktop logged in?")

def atomic_copy(s, dpath):  # temp+rename so Claude never sees a half-written index file
    fd, tmp = tempfile.mkstemp(prefix='.ccdtmp.', dir=os.path.dirname(dpath))
    os.close(fd)
    try:
        shutil.copy2(s, tmp)
        with open(tmp, 'rb') as staged:
            value = json.load(staged, parse_constant=lambda value: (_ for _ in ()).throw(ValueError('non-finite JSON')))
            if not isinstance(value, dict): raise ValueError('index must be a JSON object')
            os.fsync(staged.fileno())
        os.replace(tmp, dpath)
        directory = os.open(os.path.dirname(dpath), os.O_RDONLY)
        try: os.fsync(directory)
        finally: os.close(directory)
    finally:
        if os.path.exists(tmp): os.unlink(tmp)
def index_files(org): return [str(p) for p in Path(org).glob('local_*.json') if p.is_file()]
def newest(org): return max((os.path.getmtime(f) for f in index_files(org)), default=0)
def orgs(acct): return [str(p) for p in (Path(CCS)/acct).iterdir() if p.is_dir()]
def pick(acct_filter, label):
    cands = []
    for a in os.listdir(CCS):
        if not UUID.fullmatch(a) or not acct_filter(a): continue
        cands += orgs(a)
    if not cands: sys.exit(f"ERROR: no {label} account dir found under claude-code-sessions")
    return max(cands, key=newest)

FROM, TO = os.environ.get('CCD_FROM'), os.environ.get('CCD_TO')
dst = pick((lambda a: a.startswith(TO)) if TO else (lambda a: a == owner), 'destination(owner)')
dst_acct = os.path.basename(os.path.dirname(dst))
src = pick((lambda a: a.startswith(FROM)) if FROM else (lambda a: a != dst_acct), 'source')
if os.path.dirname(src) == os.path.dirname(dst): sys.exit("ERROR: src and dst are the same account (need a second account dir to migrate from)")
if not FROM:
    others = {a for a in os.listdir(CCS) if UUID.fullmatch(a) and a != dst_acct}
    if len(others) > 1:
        print(f"NOTE: {len(others)} non-destination accounts present; auto-picked {os.path.basename(os.path.dirname(src))[:8]} (newest activity). Override with CCD_FROM=<uuid-prefix>.")
for role, d in (('destination', dst), ('source', src)):
    n = len(orgs(os.path.basename(os.path.dirname(d))))
    if n > 1:
        print(f"WARNING: {role} account {os.path.basename(os.path.dirname(d))[:8]} has {n} org dirs; only the newest is used — verify with --dry-run before committing.")

tomb = set()
tf = os.path.join(CCS, '.tombstones')
if os.path.exists(tf): tomb = {l.strip() for l in open(tf, encoding='utf-8') if l.strip()}

new = upd = skip_t = skip_d = 0
for f in sorted(index_files(src)):
    b = os.path.basename(f); d = os.path.join(dst, b)
    if b in tomb: skip_t += 1; continue
    # Desktop markers are opaque intent. Presence wins; never delete or copy
    # markers, and never interpret a source deletion as a target deletion.
    entry = json.load(open(f, encoding='utf-8'))
    ids = [b[len('local_'):-len('.json')], entry.get('cliSessionId')]
    if os.path.isfile(d): ids.append(json.load(open(d, encoding='utf-8')).get('cliSessionId'))
    if any(os.path.lexists(os.path.join(dst, 'deleted_' + ident)) for ident in ids if ident):
        skip_d += 1; continue
    if not os.path.exists(d): act, new = 'NEW', new + 1
    elif os.path.getmtime(f) > os.path.getmtime(d) + 1: act, upd = 'UPD', upd + 1
    else: continue
    if DRY:
        try: t = json.dumps(entry.get('title') or '(no title)', ensure_ascii=True)
        except Exception: t = '(unparsable)'
        print(f"  {act} {b[:22]}… {t[:48]}")
    else: atomic_copy(f, d)

lamj = lamd = 0
sa, so = src.split('/')[-2], src.split('/')[-1]
da, do = dst.split('/')[-2], dst.split('/')[-1]
lsrc, ldst = os.path.join(LAM, sa, so), os.path.join(LAM, da, do)
if os.path.isdir(lsrc):
    if not DRY: os.makedirs(ldst, exist_ok=True)
    for e in sorted(os.listdir(lsrc)):
        p = os.path.join(lsrc, e); q = os.path.join(ldst, e)
        if e in ('rpm', 'cowork-gb-cache.json'): continue
        if e.startswith('local_') and e.endswith('.json') and os.path.isfile(p):
            if not os.path.exists(q) or os.path.getmtime(p) > os.path.getmtime(q) + 1:
                lamj += 1
                if not DRY: atomic_copy(p, q)
        elif os.path.isdir(p) and e.startswith('local_') and not os.path.exists(q):
            lamd += 1
            if not DRY: shutil.copytree(p, q)
print(f"SUMMARY src={sa[:8]}/{so[:8]} dst={da[:8]}/{do[:8]} new={new} upd={upd} lam_json={lamj} lam_dir={lamd} tombstone_skipped={skip_t} deleted_skipped={skip_d}")
PY
)
echo "$OUT"
S=$(echo "$OUT" | tail -1)

# 3) commit the migration as one isolated commit
if [ "$DRY" = 1 ]; then
  echo "(dry run — nothing changed, nothing committed)"
else
  stage
  if check_staged; then
    echo "nothing to migrate — registries already in sync"
  else
    g commit -q -m "migrate: ${S#SUMMARY }"
    echo "committed: $(g log --oneline -1)"
    echo "Fully quit and relaunch the Claude app to load the merged list."
  fi
  finish_operation
fi
